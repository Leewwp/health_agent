# docker compose 环境变量模板（复制为 .env 后填写）。
# prod profile 下缺少 DIET_SESSION_SECRET / ADMIN_TOKEN / DASHSCOPE_API_KEY 时启动失败（特性）。

# DashScope API key（必填，占位符会被 ProductionConfigurationValidator 拒绝；
# 无真实 key 的离线演示请用本地 dev 模式 + diet.agent.mode=fixture）
DASHSCOPE_API_KEY=

# 匿名 Cookie HMAC 密钥（必填，请更换为随机串）
DIET_SESSION_SECRET=change-me-to-a-random-secret

# admin 调试入口 token（必填）
ADMIN_TOKEN=change-me-admin-token

# MCP Streamable HTTP Bearer token（M5 #51；未配置时 /mcp 端点拒绝所有请求）
MCP_API_TOKEN=change-me-mcp-token

# MCP Origin allowlist（逗号分隔；留空表示本地演示不限制 Origin，生产建议显式配置）
MCP_ALLOWED_ORIGINS=

# MySQL root 密码（与后端 DATABASE_PASSWORD 共用）
MYSQL_ROOT_PASSWORD=123456

# 餐食向量索引模式：in-memory（默认，测试/离线演示）或 qdrant（真实 Qdrant，Compose 已含该服务）
DIET_VECTORSTORE_MODE=in-memory
